{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block body %}
<div class="card">
    <h1>Usuarios</h1>

    <p>
        <a class="btn" href="{{ path('admin_user_new') }}">Crear usuario</a>
    </p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.fullName }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                    <a class="btn btn-secondary" href="{{ path('admin_user_show', {id: user.id}) }}">Ver</a>
                    <a class="btn" href="{{ path('admin_user_edit', {id: user.id}) }}">Editar</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No hay usuarios.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
